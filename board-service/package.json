{
  "name": "github-board-service",
  "version": "0.1.0",
  "private": true,
  "description": "board resource service \u2014 reads GitHub, serves the board API",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "prisma generate",
    "test": "node ../scripts/run-vitest.mjs",
    "pretest:db": "prisma generate",
    "test:db": "node ../scripts/run-vitest.mjs --config vitest.db.config.ts",
    "test:watch": "prisma generate && vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.2.6",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.0",
    "@prisma/client": "^7.10.1",
    "joi": "^18.2.9",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6",
    "@prisma/adapter-pg": "^7.10.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "body-parser": "^2.4.0",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.7.4",
      "multer": "^2.5.0",
      "qs": "^6.16.1",
      "vite": "^7.3.7",
      "@hono/node-server": ">=2.0.5"
    }
  }
}
